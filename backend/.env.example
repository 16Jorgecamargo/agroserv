# Porta da API (o front-end espera 3333)
PORT=3333

# Arquivo do banco SQLite
DATABASE_PATH=data/agroserv.sqlite

# As tabelas são criadas pelas migrations ao subir a API. true sincroniza direto pelas entidades, sem migration
DB_SYNCHRONIZE=false

# Segredo e validade do token JWT. Troque o segredo fora do ambiente local
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Origens liberadas no CORS, separadas por vírgula (* libera todas)
CORS_ORIGIN=http://localhost:5173

# URL pública da API, usada nas URLs dos arquivos enviados
PUBLIC_URL=http://localhost:3333

# URL do front-end, usada no link de redefinição de senha
FRONTEND_URL=http://localhost:5173

# Pasta dos arquivos enviados
UPLOAD_DIR=uploads

# Servidor SMTP usado para enviar e-mails (recuperação de senha)
# Gmail: smtp.gmail.com, porta 587, seu e-mail em SMTP_USER e uma "senha de app" em SMTP_PASS
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Remetente dos e-mails. Se vazio, usa o SMTP_USER
# MAIL_FROM=AgroServ <voce@gmail.com>

# Custo do hash de senha
BCRYPT_ROUNDS=10

# Grava os dados demo ao iniciar com o banco vazio
SEED_ON_START=true
