# Porta da API (o front-end espera 3333)
PORT=3333

# Arquivo do banco SQLite
DATABASE_PATH=data/agroserv.sqlite

# Cria e atualiza as tabelas sozinho. Use true apenas em desenvolvimento
DB_SYNCHRONIZE=true

# Segredo e validade do token JWT. Troque o segredo fora do ambiente local
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Origens liberadas no CORS, separadas por vírgula (* libera todas)
CORS_ORIGIN=http://localhost:5173

# URL pública da API, usada nas URLs dos arquivos enviados
PUBLIC_URL=http://localhost:3333

# URL do front-end, usada no link de redefinição de senha
FRONTEND_URL=http://localhost:5173

# Pasta dos arquivos enviados
UPLOAD_DIR=uploads

# Devolve o resetToken na resposta, só para demonstração sem e-mail
EXPOSE_RESET_TOKEN=false

# Custo do hash de senha
BCRYPT_ROUNDS=10

# Grava os dados demo ao iniciar com o banco vazio
SEED_ON_START=true
